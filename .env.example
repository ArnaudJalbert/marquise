# Required — PostgreSQL connection string (Supabase or a disposable local database).
DATABASE_URL="postgresql://user:password@host:5432/postgres"
# Required for protected API routes and CLI account administration.
# Project URL and publishable key are not secrets.
# SUPABASE_URL="https://your-project-ref.supabase.co"
# SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Required for movie matching during imports. Keep this key out of logs and commits.
# TMDB_API_KEY=""

# Optional — Cineplex API key for showtime imports.
# CINEPLEX_API_KEY=""
