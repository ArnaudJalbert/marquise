# Required — Supabase project credentials.
# Get these from your Supabase project dashboard → Settings → API.
DATABASE_URL="postgresql://user:password@host:5432/postgres"
SUPABASE_URL="https://xxxxxxxxxxxxxxxxxxxx.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Optional — Cineplex API key for showtime imports.
# CINEPLEX_API_KEY=""

# Optional — OMDB API key for movie enrichment (used by CLI import).
# OMDB_API_KEY=""

# Optional — CLI authentication (used by marquise auth login).
# MARQUISE_EMAIL="user@example.com"
# MARQUISE_PASSWORD="hunter2"
